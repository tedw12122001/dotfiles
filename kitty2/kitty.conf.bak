
# Set fonts 

font_family      monospace
bold_font        auto
italic_font      auto
bold_italic_font auto
font_size        10.0

# Set background 

foreground         #9fffff
background         #000000
background_opacity 0.75

# Allow ctrl + backspace

map ctrl+backspace send_text all \x17

# Close windows without asking for confirmation
confirm_os_window_close 0
